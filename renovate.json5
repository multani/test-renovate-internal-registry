{
  "extends": ["config:recommended"],

  "helm-values": {
    "managerFilePatterns": ["*.yaml"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["*.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "/something: docker.io/(?<depName>[^:]+):(?<currentValue>.+)/",
      ],
    }
  ]
}
