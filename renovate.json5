{
  "extends": ["config:recommended"],

  "prConcurrentLimit": 0,

  "helm-values": {
    "managerFilePatterns": ["*.yaml"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["*.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "something: docker.io\/(?<depName>[^:]+):(?<currentValue>.+)",
      ],
    },

    {
      "customType": "regex",
      "managerFilePatterns": ["*.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "something: my.registry\/dockerhub\/(?<depName>[^:]+):(?<currentValue>.+)",
      ],
      "depNameTemplate": "docker.io/{{{depName}}}",
    },

    {
      "customType": "regex",
      "managerFilePatterns": ["*.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "something: my.registry\/quayio\/(?<depName>[^:]+):(?<currentValue>.+)",
      ],
      "depNameTemplate": "quay.io/{{{depName}}}",
    },
  ]
}
